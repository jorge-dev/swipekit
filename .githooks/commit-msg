#!/bin/sh
# Conventional Commits check. Enable once per clone:
#   git config core.hooksPath .githooks
#
# PR titles land on main (this repo squash-merges), so the same rule applies there,
# enforced by .github/workflows/pr-title.yml.

first=$(head -n1 "$1")

# let git's own machinery through untouched
case "$first" in
  "Merge "*|"Revert "*|"fixup! "*|"squash! "*|"amend! "*) exit 0 ;;
esac

pattern='^(feat|fix|perf|refactor|docs|test|build|ci|chore|revert)(\([a-z0-9-]+\))?!?: .+'
if printf '%s' "$first" | grep -Eq "$pattern"; then
  exit 0
fi

cat >&2 <<'MSG'

  ✗ not a Conventional Commit

    <type>[(scope)][!]: <summary>

    type   feat fix perf refactor docs test build ci chore revert
    scope  optional — collect store analyze output mcp cli skills
    !      breaking change (or a "BREAKING CHANGE:" footer)

    fix(collect): clip search captions at a word, not mid-hashtag
    feat: add outlierBasis to top_posts
    chore!: drop Node 22 support

MSG
exit 1
