{
  "$schema": "https://biomejs.dev/schemas/2.3.14/schema.json",
  "files": { "includes": ["src/**/*.ts", "test/**/*.ts"] },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 110
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "suspicious": {
        "noExplicitAny": "off"
      },
      "style": {
        "noNonNullAssertion": "off",
        "useNodejsImportProtocol": "error"
      },
      "complexity": {
        "noForEach": "off"
      }
    }
  },
  "assist": { "actions": { "source": { "organizeImports": "off" } } }
}
