# Biome formats TS itself; this covers the files it does not, and editors that
# do not run it.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
# Trailing double-space is a line break in Markdown.
trim_trailing_whitespace = false
